# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
.npm

# Next.js build output
/.next/
/out/
/build
next-env.d.ts

# Build / tooling caches
.turbo
*.tsbuildinfo

# Testing
/coverage

# Environment files (opt in per-file with a negation below if one should be committed)
.env*
!.env.example

# Local database and app data (PGlite lives in ./data/pgdata)
/data
*.db
*.db-*

# Logs
*.log
npm-debug.log*

# Deploy platform caches
.netlify
.vercel

# Editors / IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea

# OS cruft
.DS_Store
Thumbs.db

# Secrets / certificates
*.pem
