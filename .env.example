# ─── Edition ──────────────────────────────────────────────────────────────────
# "self-hosted" (default) runs single-tenant: one organization is created on
# first run. "cloud" enables the hosted, multi-tenant behaviour and refuses to
# start without DATABASE_URL and BUSSOLA_ENCRYPTION_KEY.
BUSSOLA_EDITION=self-hosted

# ─── Database ─────────────────────────────────────────────────────────────────
# Leave empty to use PGlite — Postgres compiled to WASM, stored under
# BUSSOLA_DATA_DIR. No server, no Docker, ideal for a single local user.
#
# Set it to any Postgres connection string to use a real server. Required for
# cloud, and recommended for any install serving more than one person, because
# PGlite is single-process by design.
#   docker compose up -d db
#   DATABASE_URL=postgres://bussola:bussola@localhost:5432/bussola
DATABASE_URL=

# Max pooled connections when DATABASE_URL is set.
DATABASE_POOL_MAX=10

# Where PGlite keeps its data directory (defaults to ./data).
BUSSOLA_DATA_DIR=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Signing key for sessions: openssl rand -hex 32
# Self-hosted falls back to a deterministic local-dev value; cloud refuses to
# start without it.
BETTER_AUTH_SECRET=

# Public origin of the app. Leave empty for self-hosting: the origin is taken
# from the request, so any port or domain works without configuration. Set it
# for a hosted deployment, where an explicit trusted origin is what you want.
BETTER_AUTH_URL=

# ─── Secrets ──────────────────────────────────────────────────────────────────
# 64-char hex key: openssl rand -hex 32
# Encrypts provider API tokens at rest. Self-hosted installs fall back to a
# deterministic local-dev key if unset — fine on your laptop, never in the
# cloud, where startup fails without it.
BUSSOLA_ENCRYPTION_KEY=

# ─── Sync worker ──────────────────────────────────────────────────────────────
# Widget requests are served from snapshots that a background worker refreshes,
# so upstream provider traffic scales with connections, not with page views.
#
# Self-hosted runs the worker inside the Next server automatically. Set this to
# 1 when you run it separately (npm run worker) or deploy more than one app
# instance, so they do not all schedule at once.
BUSSOLA_DISABLE_INLINE_SYNC=

# Shared secret for POST /api/internal/sync, the cron entry point for platforms
# that schedule an HTTP request instead of running a process. Unset = closed.
BUSSOLA_SYNC_SECRET=

# Seconds between scheduler ticks, and connections claimed per tick.
BUSSOLA_SYNC_TICK_SECONDS=15
BUSSOLA_SYNC_BATCH=25

# ─── Billing (hosted edition only) ────────────────────────────────────────────
# Self-hosted ignores all of this: every limit is unlimited and the Stripe
# client is never constructed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe price ids per plan and interval. A plan with no configured price is
# simply not offered for sale, and a price we do not recognise resolves to the
# trial rather than granting the higher plan.
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
# Per-seat price for Team members beyond the five included.
STRIPE_PRICE_TEAM_SEAT=
